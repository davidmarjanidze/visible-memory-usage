{
  "name": "visible-memory-usage",
  "version": "2.0.0",
  "description": "Show memory usage of a Node.js process as a colored bar in the terminal.",
  "author": "Dato Marjanidze",
  "license": "ISC",
  "homepage": "https://github.com/davidmarjanidze/visible-memory-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmarjanidze/visible-memory-usage.git"
  },
  "bugs": {
    "url": "https://github.com/davidmarjanidze/visible-memory-usage/issues"
  },
  "keywords": [
    "memory",
    "memory usage",
    "memory leak",
    "heap",
    "terminal",
    "progress bar"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "npm-publish": "npm run typecheck && npm run lint && npm run build && npm publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
